# Copiar a .env para correr el servicio fuera de Docker. En Docker las pasa el compose.
# Nunca poner secretos: el KV de Consul guarda en texto plano.

# URL del agente de Consul.
CONSUL_URL=http://localhost:8500
# Raíz del KV bajo la que viven todas las claves.
CONSUL_KV_ROOT=pdf-extractext
# Segundos de espera antes de dar a Consul por caído.
CONSUL_TIMEOUT_SECONDS=2
# Puerto HTTP del servicio.
PORT=8000
